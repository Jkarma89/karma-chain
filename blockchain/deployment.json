        "keyDir": "blockchain/validators/dev/node-2/"
      },
      {
        "index": 3,
        "httpPort": 21664,
        "stakingPort": 21665,
        "keyDir": "blockchain/validators/dev/node-3/"
      },
      {
        "index": 4,
        "httpPort": 21666,
        "stakingPort": 21667,
        "keyDir": "blockchain/validators/dev/node-4/"
      },
      {
        "index": 5,
        "httpPort": 21668,
        "stakingPort": 21669,
        "keyDir": "blockchain/validators/dev/node-5/"
      }
    ]
  }
}
