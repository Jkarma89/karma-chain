# docker/binaries.env —— 版本锁定二进制的 sha256 校验值（唯一出处）
#
# 版本号本身的唯一事实来源是 blockchain/protocol.json（avalanche.*Version）；
# 本文件只承载它们对应的校验值，并由 tests/unit/binaries-env.test.mjs 断言两者一致。
#
# 为什么单独成文件：docker/bootstrap/ 与 docker/node/ 都要下载并校验这些二进制
# （docker/devnet/ 在 T080 退役前也还在用），校验值写在各自的 Dockerfile 里就是三份副本。
#
# 校验值来源：2026-09-01 从 GitHub Releases 下载后计算。
# avalanchego 官方只提供 .sig；subnet-evm / signature-aggregator 另有 checksums.txt 且已核对一致。
# 升级任一版本 = 协议变更（宪法第十五条）：同步改 protocol.json、本文件、tools/protocol/load.mjs 兼容表。

AVALANCHEGO_VERSION=v1.14.1
SUBNET_EVM_VERSION=v0.8.0
SIGNATURE_AGGREGATOR_VERSION=v0.5.3
ICM_CONTRACTS_VERSION=v1.0.0

SHA_AVALANCHEGO_AMD64=9b94689364a1317fbd561919fd3c9a1dbbe92d2526dabe461b6fc41efe5cdfc3
SHA_AVALANCHEGO_ARM64=335829c8a5f73f3f4de21ab2fb5e6d66eeeca0016151c93f538acaf99e8df7c5
SHA_SUBNET_EVM_AMD64=f9cfd6438be5b4fb134a298f9abc0a4835d5c734dcd5ddb352d0eb3127e11b17
SHA_SUBNET_EVM_ARM64=40719bdbf762a29648358cd36b9d44792697451ab39ac6c3eed51838f37be47b
SHA_SIG_AGG_AMD64=c5672745f57c7b8b2c841a03febdbb50998dce4f6b4bbe5764dae92291b619dd
SHA_SIG_AGG_ARM64=b68c4a3164234c9f32b1ed5b979be4af88d1e6eb82e196ba54cbc1b09f1a3846

