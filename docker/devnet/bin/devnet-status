#!/usr/bin/env bash
# devnet-status —— 每节点健康/共识状态（FR-032）。
# 用法：devnet-status [--json]
# 退出码：0 全部健康 | 1 存在不健康节点 | 2 网络未运行
set -uo pipefail

: "${KARMACHAIN_LIB:=/opt/karmachain/lib}"
source "${KARMACHAIN_LIB}/health.sh"

if ! nodes_primary_dir >/dev/null 2>&1; then
  echo "devnet-status: no local network found — run scripts/devnet-start" >&2
  exit 2
fi

STATE="$(health_all_json)" || { echo "devnet-status: failed to collect node state" >&2; exit 2; }

if [ "${1:-}" = "--json" ]; then
  printf '%s\n' "${STATE}"
  [ "$(jq -r '.unhealthy' <<<"${STATE}")" = "0" ] && exit 0 || exit 1
fi

printf '\nKarmaChain node status   chainId %s   height %s   (%s)\n\n' \
  "$(jq -r '.chainIdHex // "n/a"' <<<"${STATE}")" \
  "$(jq -r '.blockHeight // "n/a"' <<<"${STATE}")" \
  "$(jq -r '.generatedAt' <<<"${STATE}")"

printf '%-11s %-13s %-6s %-8s %-8s %-13s %-6s %s\n' NODE ROLE PORT RUNNING HEALTHY BOOTSTRAPPED PEERS NODE-ID
jq -r '.nodes[] | [.label, .role, .httpPort, (.running|tostring), (.healthy|tostring),
                   (.bootstrapped|tostring), (.peers // "-" | tostring),
                   (.nodeId + (if .nodeIdMatches == false then "  << MISMATCH" else "" end))] | @tsv' <<<"${STATE}" \
  | while IFS=$'\t' read -r label role port running healthy boot peers id; do
      printf '%-11s %-13s %-6s %-8s %-8s %-13s %-6s %s\n' "${label}" "${role}" "${port}" "${running}" "${healthy}" "${boot}" "${peers}" "${id}"
    done

UNHEALTHY="$(jq -r '.unhealthy' <<<"${STATE}")"
TOTAL="$(jq -r '.nodes | length' <<<"${STATE}")"
echo
if [ "${UNHEALTHY}" = "0" ]; then
  printf 'all %s nodes healthy\n\n' "${TOTAL}"
  exit 0
fi
printf '%s/%s nodes NOT healthy [category: node] — inspect with: scripts/devnet-logs <node>\n\n' "${UNHEALTHY}" "${TOTAL}" >&2
exit 1
