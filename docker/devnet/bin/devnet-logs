#!/usr/bin/env bash
# devnet-logs —— 按节点查看日志（FR-031）。日志含时间戳与级别（avalanchego plain 格式）。
#
# 用法：devnet-logs [<node>] [选项]
#   <node>        l1-1..l1-5 / primary-1 / primary-2；省略则列出可选节点与日志文件
#   --chain       看 L1 链的日志（默认是 main.log，即节点自身日志）
#   --file <name> 指定日志文件名
#   -f            跟随（tail -f）
#   -n <N>        末尾 N 行（默认 200）
#   --raw         不脱敏（危险：avalanchego 会把启动标志连同 staking 私钥写进 main.log）
#
# 默认脱敏（FR-026）：屏蔽 *-key-file-content / signerKeyContent 等字段的值。
set -uo pipefail

: "${KARMACHAIN_LIB:=/opt/karmachain/lib}"
source "${KARMACHAIN_LIB}/nodes.sh"

NODE=""; FILE=""; FOLLOW=0; LINES=200; RAW=0; WANT_CHAIN=0
while [ $# -gt 0 ]; do
  case "$1" in
    -f|--follow) FOLLOW=1 ;;
    -n) LINES="$2"; shift ;;
    --file) FILE="$2"; shift ;;
    --chain) WANT_CHAIN=1 ;;
    --raw) RAW=1 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "devnet-logs: unknown option $1" >&2; exit 2 ;;
    *) NODE="$1" ;;
  esac
  shift
done

INV="$(nodes_inventory_json 2>/dev/null)" || { echo "devnet-logs: no local network found — run scripts/devnet-start" >&2; exit 2; }

node_dir() { # node_dir <label>
  local role port
  role="$(jq -r --arg l "$1" '.nodes[] | select(.label == $l) | .role' <<<"${INV}")"
  port="$(jq -r --arg l "$1" '.nodes[] | select(.label == $l) | .httpPort' <<<"${INV}")"
  [ -n "${role}" ] || return 1
  local base
  if [ "${role}" = "primary" ]; then base="$(nodes_primary_dir)"; else base="$(nodes_l1_dir)"; fi
  local d
  for d in "${base}"/NodeID-*; do
    [ -r "${d}/process.json" ] || continue
    [ "$(jq -r '.uri' "${d}/process.json" | sed 's/.*://')" = "${port}" ] && { printf '%s' "${d}"; return 0; }
  done
  return 1
}

if [ -z "${NODE}" ]; then
  echo
  echo "usage: devnet-logs <node> [--chain] [--file <name>] [-f] [-n N] [--raw]"
  echo
  printf '%-11s %-13s %s\n' NODE ROLE 'LOG FILES'
  labels="$(jq -r '.nodes[].label' <<<"${INV}")"
  for l in ${labels}; do
    d="$(node_dir "${l}" || true)"
    files="$( [ -n "${d}" ] && ls "${d}/logs" 2>/dev/null | tr '\n' ' ' )"
    printf '%-11s %-13s %s\n' "${l}" "$(jq -r --arg l "${l}" '.nodes[] | select(.label==$l) | .role' <<<"${INV}")" "${files:-<none>}"
  done
  echo
  exit 0
fi

DIR="$(node_dir "${NODE}")" || { echo "devnet-logs: unknown node '${NODE}' (see: devnet-logs)" >&2; exit 2; }
LOGDIR="${DIR}/logs"

if [ -z "${FILE}" ]; then
  if [ "${WANT_CHAIN}" = "1" ]; then
    # L1 链日志以 BlockchainID 命名；取最近修改且非轮转的那个
    FILE="$(ls -t "${LOGDIR}" 2>/dev/null | grep -vE '^(main|P|C|X|vm-factory)\.log$' | grep -vE '[0-9]{4}-[0-9]{2}-[0-9]{2}T' | head -1)"
    [ -n "${FILE}" ] || { echo "devnet-logs: no chain log found in ${LOGDIR}" >&2; exit 2; }
  else
    FILE="main.log"
  fi
fi
[ -r "${LOGDIR}/${FILE}" ] || { echo "devnet-logs: ${LOGDIR}/${FILE} not readable (available: $(ls "${LOGDIR}" | tr '\n' ' '))" >&2; exit 2; }

# 脱敏：avalanchego 在启动时把 providedFlags 全量打进 main.log，其中包含 staking TLS 私钥与 BLS signer key
redact() {
  if [ "${RAW}" = "1" ]; then cat; else
    sed -E \
      -e 's/("(staking-tls-key-file-content|staking-signer-key-file-content|staking-tls-cert-file-content)":")[^"]*"/\1<redacted>"/g' \
      -e 's/("(signerKeyContent|privateKey|mnemonic|password|secret)":")[^"]*"/\1<redacted>"/g' \
      -e 's/(-----BEGIN [A-Z ]*PRIVATE KEY-----)[^-]*/\1<redacted>/g'
  fi
}

echo "== ${NODE} ${LOGDIR}/${FILE} $( [ "${RAW}" = "1" ] && echo '(RAW — may contain dev key material)' || echo '(key material redacted; --raw to disable)' ) ==" >&2
if [ "${FOLLOW}" = "1" ]; then
  tail -n "${LINES}" -f "${LOGDIR}/${FILE}" | redact
else
  tail -n "${LINES}" "${LOGDIR}/${FILE}" | redact
fi
